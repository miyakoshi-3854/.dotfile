[include]
    path = ~/.config/git/config.local
[pull]
    ff = only
    rebase = false
[core]
    eol = lf
    ignorecase = false
    quotepath = false
[init]
    defaultBranch = main
[fetch]
    prune = true
[rebase]
    autosquash = true
[alias]
    m = merge
    pl = pull
    p = push
    t = stash push --staged -m
[ghq]
    root = ~/ghq